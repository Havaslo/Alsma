generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  active
  inactive
}

enum LeadStatus {
  new
  processing
  completed
  cancelled
}

enum ContentStatus {
  draft
  published
  archived
}

model AppSetting {
  key       String   @id
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  value     Json

  @@map("app_settings")
}

model AdminRole {
  id          String      @id @default(uuid()) @db.Uuid
  name        String      @unique
  description String?
  permissions String[]    @default([])
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  users       AdminUser[]

  @@map("admin_roles")
}

model AdminUser {
  id           String        @id @default(uuid()) @db.Uuid
  email        String        @unique
  displayName  String        @map("display_name")
  passwordHash String        @map("password_hash")
  status       UserStatus    @default(active)
  permissionOverrides Json   @default("{}") @map("permission_overrides")
  roleId       String?       @map("role_id") @db.Uuid
  role         AdminRole?    @relation(fields: [roleId], references: [id], onDelete: SetNull)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  sessions     AdminSession[]
  tasks        ManagerTask[] @relation("TaskAssignee")

  @@map("admin_users")
}

model AdminSession {
  id        String    @id @default(uuid()) @db.Uuid
  tokenHash String    @unique @map("token_hash")
  userId    String    @map("user_id") @db.Uuid
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([userId])
  @@map("admin_sessions")
}

model GuestUser {
  id             String         @id @default(uuid()) @db.Uuid
  phone          String         @unique
  fullName       String?        @map("full_name")
  email          String?
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  loginCodes     GuestLoginCode[]
  bonusProgram   GuestBonusProgram?
  bookings       GuestBooking[]

  @@map("guest_users")
}

model GuestLoginCode {
  id         String    @id @default(uuid()) @db.Uuid
  phone      String
  codeHash   String    @map("code_hash")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)
  userId     String?   @map("user_id") @db.Uuid
  user       GuestUser? @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([phone, expiresAt])
  @@map("guest_login_codes")
}

model GuestBonusProgram {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @unique @map("user_id") @db.Uuid
  user      GuestUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance   Int       @default(0)
  level     String    @default("standard")
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("guest_bonus_programs")
}

model GuestBooking {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  user         GuestUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  roomName     String    @map("room_name")
  checkInDate  DateTime  @map("check_in_date") @db.Date
  checkOutDate DateTime  @map("check_out_date") @db.Date
  guestsCount  Int       @map("guests_count")
  status       String    @default("confirmed")
  totalAmount  Decimal?  @map("total_amount") @db.Decimal(12, 2)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([userId, checkInDate])
  @@map("guest_bookings")
}

model SiteLead {
  id          String     @id @default(uuid()) @db.Uuid
  sourcePage  String     @map("source_page")
  formCode    String     @map("form_code")
  formTitle   String     @map("form_title")
  name        String?
  phone       String?
  email       String?
  details     Json       @default("{}")
  status      LeadStatus @default(new)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([status, createdAt])
  @@map("site_leads")
}

model BookingRequest {
  id           String     @id @default(uuid()) @db.Uuid
  guestName    String     @map("guest_name")
  phone        String
  email        String?
  checkInDate  DateTime?  @map("check_in_date") @db.Date
  checkOutDate DateTime?  @map("check_out_date") @db.Date
  guestsCount  Int        @default(1) @map("guests_count")
  roomName     String?    @map("room_name")
  amount       Decimal?   @db.Decimal(12, 2)
  status       LeadStatus @default(new)
  paidAt       DateTime?  @map("paid_at") @db.Timestamptz(3)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([status, createdAt])
  @@map("booking_requests")
}

model AdminRequest {
  id          String     @id @default(uuid()) @db.Uuid
  title       String
  description String?
  requester   String?
  contact     String?
  category    String
  status      LeadStatus @default(new)
  details     Json       @default("{}")
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([status, createdAt])
  @@map("admin_requests")
}

model ManagerTask {
  id          String      @id @default(uuid()) @db.Uuid
  title       String
  description String?
  status      String      @default("pending")
  priority    String      @default("normal")
  assigneeId  String?     @map("assignee_id") @db.Uuid
  assignee    AdminUser?  @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  dueAt       DateTime?   @map("due_at") @db.Timestamptz(3)
  completedAt DateTime?   @map("completed_at") @db.Timestamptz(3)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([assigneeId, status])
  @@map("manager_tasks")
}

model UploadedFile {
  id           String   @id @default(uuid()) @db.Uuid
  fileName     String   @map("file_name")
  contentType  String   @map("content_type")
  sizeBytes    Int      @map("size_bytes")
  content      Bytes
  category     String
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([category, createdAt])
  @@map("uploaded_files")
}

model SiteContent {
  id        String        @id @default(uuid()) @db.Uuid
  section   String
  itemKey   String        @map("item_key")
  title     String?
  content   Json
  position  Int           @default(0)
  status    ContentStatus @default(published)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([section, itemKey])
  @@index([section, position])
  @@map("site_content")
}

model KnowledgeArticle {
  id          String           @id @default(uuid()) @db.Uuid
  title       String
  content     String
  status      ContentStatus    @default(draft)
  publishedAt DateTime?        @map("published_at") @db.Timestamptz(3)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  chunks      KnowledgeChunk[]

  @@map("knowledge_articles")
}

model KnowledgeChunk {
  id         String           @id @default(uuid()) @db.Uuid
  articleId  String           @map("article_id") @db.Uuid
  article    KnowledgeArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  chunkIndex Int              @map("chunk_index")
  content    String
  searchText Unsupported("tsvector")? @map("search_text")

  @@unique([articleId, chunkIndex])
  @@map("knowledge_chunks")
}

model AgentRule {
  id        String   @id @default(uuid()) @db.Uuid
  title     String
  content   String
  enabled   Boolean  @default(true)
  priority  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("agent_rules")
}

model AgentScenario {
  id          String   @id @default(uuid()) @db.Uuid
  title       String
  trigger     String
  response    String
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("agent_scenarios")
}

model AgentTransferRule {
  id          String   @id @default(uuid()) @db.Uuid
  title       String
  condition   String
  destination String
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("agent_transfer_rules")
}

model KnowledgeQueryLog {
  id        String   @id @default(uuid()) @db.Uuid
  query     String
  answer    String?
  sources   Json     @default("[]")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([createdAt])
  @@map("knowledge_query_logs")
}
