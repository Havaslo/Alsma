generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  active
  inactive
}

enum LeadStatus {
  new
  processing
  completed
  cancelled
}

enum ContentStatus {
  draft
  published
  archived
}

model AppSetting {
  key       String   @id
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  value     Json

  @@map("app_settings")
}

model AdminRole {
  id          String      @id @default(uuid()) @db.Uuid
  name        String      @unique
  description String?
  permissions String[]    @default([])
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  users       AdminUser[]

  @@map("admin_roles")
}

model AdminUser {
  id                  String         @id @default(uuid()) @db.Uuid
  email               String         @unique
  displayName         String         @map("display_name")
  passwordHash        String         @map("password_hash")
  status              UserStatus     @default(active)
  permissionOverrides Json           @default("{}") @map("permission_overrides")
  roleId              String?        @map("role_id") @db.Uuid
  role                AdminRole?     @relation(fields: [roleId], references: [id], onDelete: SetNull)
  createdAt           DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  sessions            AdminSession[]
  tasks               ManagerTask[]  @relation("TaskAssignee")

  @@map("admin_users")
}

model AdminSession {
  id        String    @id @default(uuid()) @db.Uuid
  tokenHash String    @unique @map("token_hash")
  userId    String    @map("user_id") @db.Uuid
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([userId])
  @@map("admin_sessions")
}

model GuestUser {
  id                 String                   @id @default(uuid()) @db.Uuid
  phone              String                   @unique
  fullName           String?                  @map("full_name")
  email              String?
  createdAt          DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  loginCodes         GuestLoginCode[]
  emailVerifications GuestEmailVerification[]
  bonusProgram       GuestBonusProgram?
  bookings           GuestBooking[]
  serviceOrders      ServiceOrder[]

  @@map("guest_users")
}

model Service {
  id          String                    @id @default(uuid()) @db.Uuid
  slug        String                    @unique
  name        String
  description String?
  imageUrl    String?                   @map("image_url")
  status      String                    @default("draft")
  createdAt   DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(3)
  sectionId   String?                   @map("section_id") @db.Uuid
  section     ServiceSection?           @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  variants    ServiceVariant[]
  placements  ServicePagePlacement[]
  rules       ServiceAvailabilityRule[]
  blocks      ServiceScheduleBlock[]
  orders      ServiceOrderItem[]
  bookings    ServiceBooking[]

  @@map("services")
}

model ServiceSection {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  pageSlug    String    @map("page_slug")
  heading     String
  subheading  String?   @map("subheading")
  blockNumber Int       @map("block_number")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  services    Service[]

  @@index([pageSlug, blockNumber])
  @@map("service_sections")
}

model ServiceVariant {
  id             String                 @id @default(uuid()) @db.Uuid
  serviceId      String                 @map("service_id") @db.Uuid
  service        Service                @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  price          Decimal                @db.Decimal(12, 2)
  currency       String                 @default("RUB")
  capacity       Int
  durationMin    Int?                   @map("duration_min")
  active         Boolean                @default(true)
  createdAt      DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  orders         ServiceOrderItem[]
  bookings       ServiceBooking[]
  scheduleBlocks ServiceScheduleBlock[]

  @@index([serviceId, active])
  @@map("service_variants")
}

model ServicePagePlacement {
  id        String  @id @default(uuid()) @db.Uuid
  serviceId String  @map("service_id") @db.Uuid
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  pageSlug  String  @map("page_slug")
  position  Int     @default(0)

  @@unique([serviceId, pageSlug])
  @@map("service_page_placements")
}

model ServiceAvailabilityRule {
  id        String  @id @default(uuid()) @db.Uuid
  serviceId String  @map("service_id") @db.Uuid
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  weekday   Int
  startTime String  @map("start_time")
  endTime   String  @map("end_time")

  @@index([serviceId, weekday])
  @@map("service_availability_rules")
}

model ServiceScheduleBlock {
  id        String          @id @default(uuid()) @db.Uuid
  serviceId String          @map("service_id") @db.Uuid
  service   Service         @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  variantId String?         @map("variant_id") @db.Uuid
  variant   ServiceVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  startsAt  DateTime        @map("starts_at") @db.Timestamptz(3)
  endsAt    DateTime        @map("ends_at") @db.Timestamptz(3)
  capacity  Int

  @@index([serviceId, startsAt])
  @@map("service_schedule_blocks")
}

model ServiceOrder {
  id              String             @id @default(uuid()) @db.Uuid
  userId          String?            @map("user_id") @db.Uuid
  user            GuestUser?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  name            String
  email           String
  phone           String
  status          String             @default("new")
  paymentStatus   String             @default("pending") @map("payment_status")
  paidAt          DateTime?          @map("paid_at") @db.Timestamptz(3)
  total           Decimal            @db.Decimal(12, 2)
  currency        String             @default("RUB")
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  items           ServiceOrderItem[]
  paymentAttempts PaymentAttempt[]

  @@index([userId, createdAt])
  @@map("service_orders")
}

model ServiceOrderItem {
  id        String          @id @default(uuid()) @db.Uuid
  orderId   String          @map("order_id") @db.Uuid
  order     ServiceOrder    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  serviceId String          @map("service_id") @db.Uuid
  service   Service         @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  variantId String          @map("variant_id") @db.Uuid
  variant   ServiceVariant  @relation(fields: [variantId], references: [id], onDelete: Restrict)
  quantity  Int             @default(1)
  unitPrice Decimal         @map("unit_price") @db.Decimal(12, 2)
  booking   ServiceBooking?

  @@map("service_order_items")
}

model ServiceBooking {
  id          String           @id @default(uuid()) @db.Uuid
  orderItemId String           @unique @map("order_item_id") @db.Uuid
  orderItem   ServiceOrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  serviceId   String           @map("service_id") @db.Uuid
  service     Service          @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  variantId   String           @map("variant_id") @db.Uuid
  variant     ServiceVariant   @relation(fields: [variantId], references: [id], onDelete: Restrict)
  startsAt    DateTime         @map("starts_at") @db.Timestamptz(3)
  endsAt      DateTime         @map("ends_at") @db.Timestamptz(3)
  status      String           @default("requested")
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([startsAt, status])
  @@map("service_bookings")
}

model PaymentAttempt {
  id         String       @id @default(uuid()) @db.Uuid
  orderId    String       @map("order_id") @db.Uuid
  order      ServiceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider   String
  status     String       @default("not_started")
  externalId String?      @map("external_id")
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([orderId, createdAt])
  @@map("payment_attempts")
}

model GuestEmailVerification {
  id         String     @id @default(uuid()) @db.Uuid
  email      String
  codeHash   String     @map("code_hash")
  messageId  String?    @unique @map("message_id")
  expiresAt  DateTime   @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime?  @map("consumed_at") @db.Timestamptz(3)
  sentAt     DateTime?  @map("sent_at") @db.Timestamptz(3)
  attempts   Int        @default(0)
  lastSentAt DateTime   @default(now()) @map("last_sent_at") @db.Timestamptz(3)
  userId     String?    @map("user_id") @db.Uuid
  user       GuestUser? @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([email, createdAt])
  @@map("guest_email_verifications")
}

model GuestLoginCode {
  id         String     @id @default(uuid()) @db.Uuid
  phone      String
  codeHash   String     @map("code_hash")
  expiresAt  DateTime   @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime?  @map("consumed_at") @db.Timestamptz(3)
  userId     String?    @map("user_id") @db.Uuid
  user       GuestUser? @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([phone, expiresAt])
  @@map("guest_login_codes")
}

model GuestBonusProgram {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @unique @map("user_id") @db.Uuid
  user      GuestUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance   Int       @default(0)
  level     String    @default("standard")
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("guest_bonus_programs")
}

model GuestBooking {
  id                  String    @id @default(uuid()) @db.Uuid
  userId              String    @map("user_id") @db.Uuid
  user                GuestUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  roomName            String    @map("room_name")
  checkInDate         DateTime  @map("check_in_date") @db.Date
  checkOutDate        DateTime  @map("check_out_date") @db.Date
  guestsCount         Int       @map("guests_count")
  status              String    @default("confirmed")
  totalAmount         Decimal?  @map("total_amount") @db.Decimal(12, 2)
  currency            String    @default("RUB")
  paymentStatus       String    @default("payment_pending") @map("payment_status")
  paymentMethod       String    @default("full") @map("payment_method")
  paymentAmount       Decimal?  @map("payment_amount") @db.Decimal(12, 2)
  paymentId           String?   @unique @map("payment_id")
  epteraReservationId String?   @unique @map("eptera_reservation_id")
  voucherNumber       String?   @map("voucher_number")
  contactFirstName    String?   @map("contact_first_name")
  contactLastName     String?   @map("contact_last_name")
  contactPhone        String?   @map("contact_phone")
  contactEmail        String?   @map("contact_email")
  contactComment      String?   @map("contact_comment")
  guestList           Json?     @map("guest_list")
  selectedOffer       Json?     @map("selected_offer")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([userId, checkInDate])
  @@map("guest_bookings")
}

model SiteLead {
  id         String     @id @default(uuid()) @db.Uuid
  sourcePage String     @map("source_page")
  formCode   String     @map("form_code")
  formTitle  String     @map("form_title")
  name       String?
  phone      String?
  email      String?
  details    Json       @default("{}")
  status     LeadStatus @default(new)
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([status, createdAt])
  @@map("site_leads")
}

model BookingRequest {
  id             String       @id @default(uuid()) @db.Uuid
  guestName      String       @map("guest_name")
  phone          String
  email          String?
  checkInDate    DateTime?    @map("check_in_date") @db.Date
  checkOutDate   DateTime?    @map("check_out_date") @db.Date
  guestsCount    Int          @default(1) @map("guests_count")
  roomName       String?      @map("room_name")
  amount         Decimal?     @db.Decimal(12, 2)
  status         LeadStatus   @default(new)
  paidAt         DateTime?    @map("paid_at") @db.Timestamptz(3)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  adminRequestId String       @map("admin_request_id") @db.Uuid
  adminRequest   AdminRequest @relation(fields: [adminRequestId], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@index([adminRequestId])
  @@map("booking_requests")
}

model AdminRequest {
  id              String           @id @default(uuid()) @db.Uuid
  title           String
  description     String?
  requester       String?
  contact         String?
  category        String
  status          LeadStatus       @default(new)
  details         Json             @default("{}")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  chatMessages    ChatMessage[]
  bookingRequests BookingRequest[]
  voiceCalls      VoiceCall[]

  @@index([status, createdAt])
  @@map("admin_requests")
}

model ChatMessage {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @map("conversation_id") @db.Uuid
  conversation   AdminRequest @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  author         String
  text           String
  bookingUrl     String?      @map("booking_url")
  externalId     String?      @map("external_id")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([conversationId, externalId])
  @@index([conversationId, createdAt])
  @@map("chat_messages")
}

model ManagerTask {
  id          String     @id @default(uuid()) @db.Uuid
  title       String
  description String?
  status      String     @default("pending")
  priority    String     @default("normal")
  assigneeId  String?    @map("assignee_id") @db.Uuid
  assignee    AdminUser? @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  dueAt       DateTime?  @map("due_at") @db.Timestamptz(3)
  completedAt DateTime?  @map("completed_at") @db.Timestamptz(3)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([assigneeId, status])
  @@map("manager_tasks")
}

model UploadedFile {
  id          String   @id @default(uuid()) @db.Uuid
  fileName    String   @map("file_name")
  contentType String   @map("content_type")
  sizeBytes   Int      @map("size_bytes")
  content     Bytes
  category    String
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([category, createdAt])
  @@map("uploaded_files")
}

model SiteContent {
  id        String        @id @default(uuid()) @db.Uuid
  section   String
  itemKey   String        @map("item_key")
  title     String?
  content   Json
  position  Int           @default(0)
  status    ContentStatus @default(published)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([section, itemKey])
  @@index([section, position])
  @@map("site_content")
}

model KnowledgeArticle {
  id          String           @id @default(uuid()) @db.Uuid
  title       String
  slug        String           @default("")
  summary     String           @default("")
  category    String           @default("")
  tags        String[]         @default([])
  channels    String[]         @default(["text", "voice"])
  content     String
  status      ContentStatus    @default(draft)
  publishedAt DateTime?        @map("published_at") @db.Timestamptz(3)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  chunks      KnowledgeChunk[]

  @@map("knowledge_articles")
}

model KnowledgeChunk {
  id         String                   @id @default(uuid()) @db.Uuid
  articleId  String                   @map("article_id") @db.Uuid
  article    KnowledgeArticle         @relation(fields: [articleId], references: [id], onDelete: Cascade)
  chunkIndex Int                      @map("chunk_index")
  content    String
  searchText Unsupported("tsvector")? @map("search_text")

  @@unique([articleId, chunkIndex])
  @@map("knowledge_chunks")
}

model AgentRule {
  id        String   @id @default(uuid()) @db.Uuid
  title     String
  content   String
  channels  String[] @default(["text", "voice"])
  enabled   Boolean  @default(true)
  priority  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("agent_rules")
}

model AgentScenario {
  id        String   @id @default(uuid()) @db.Uuid
  title     String
  trigger   String
  response  String
  action    String   @default("answer")
  page      String?
  enabled   Boolean  @default(true)
  channels  String[] @default(["text"])
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("agent_scenarios")
}

model AgentTransferRule {
  id          String   @id @default(uuid()) @db.Uuid
  title       String
  condition   String
  destination String
  enabled     Boolean  @default(true)
  channels    String[] @default(["text"])
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("agent_transfer_rules")
}

model KnowledgeQueryLog {
  id        String   @id @default(uuid()) @db.Uuid
  channel   String   @default("text")
  query     String
  answer    String?
  status    String   @default("answered")
  sources   Json     @default("[]")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([createdAt])
  @@map("knowledge_query_logs")
}

model VoiceCall {
  id                     String        @id @default(uuid()) @db.Uuid
  provider               String        @default("t2")
  providerCallId         String?       @unique @map("provider_call_id")
  sipCallId              String?       @unique @map("sip_call_id")
  mangoCallId            String?       @map("mango_call_id")
  mangoTransferInitiator String?       @map("mango_transfer_initiator")
  providerEntryId        String?       @map("provider_entry_id")
  providerSequence       Int?          @map("provider_sequence")
  callerPhone            String?       @map("caller_phone")
  status                 String        @default("active")
  outcome                String?
  startedAt              DateTime      @default(now()) @map("started_at") @db.Timestamptz(3)
  endedAt                DateTime?     @map("ended_at") @db.Timestamptz(3)
  durationSec            Int?          @map("duration_sec")
  transcript             Json          @default("[]")
  summary                String?
  intent                 String?
  extracted              Json          @default("{}")
  recordingUrl           String?       @map("recording_url")
  recordingObjectId      String?       @map("recording_object_id")
  providerRecordingId    String?       @map("provider_recording_id")
  recordingStatus        String?       @map("recording_status")
  transferCommandId      String?       @map("transfer_command_id")
  transferState          String?       @map("transfer_state")
  adminRequestId         String?       @unique @map("admin_request_id") @db.Uuid
  adminRequest           AdminRequest? @relation(fields: [adminRequestId], references: [id], onDelete: SetNull)
  createdAt              DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([status, createdAt])
  @@index([callerPhone, createdAt])
  @@index([providerEntryId, startedAt])
  @@index([endedAt])
  @@index([transferCommandId])
  @@map("voice_calls")
}

model VoiceWebhookEvent {
  id        String   @id @default(uuid()) @db.Uuid
  provider  String
  eventKey  String   @unique @map("event_key")
  entryId   String?  @map("entry_id")
  callId    String?  @map("call_id")
  sequence  Int?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([provider, entryId])
  @@map("voice_webhook_events")
}

model MaxWebhookUpdate {
  id        String   @id
  status    String   @default("processing")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([createdAt])
  @@map("max_webhook_updates")
}

model VkWebhookUpdate {
  id        String   @id
  groupId   String   @map("group_id")
  status    String   @default("processing")
  payload   Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([createdAt])
  @@map("vk_webhook_updates")
}
